APP_NAME="Sistema de Gestión Documental - Facultad de Tecnología"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://documentos.example.invalid

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

INSTITUTION_UNIVERSITY="Universidad Mayor de San Andrés"
INSTITUTION_FACULTY="Facultad de Tecnología"
INSTITUTION_ACRONYM=FTEC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgresql.internal
DB_PORT=5432
DB_DATABASE=sistema_teletrabajo
DB_USERNAME=sistema_teletrabajo_app
DB_PASSWORD=
DB_SSLMODE=require
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=
DB_TIMEZONE=America/La_Paz
DB_APPLICATION_NAME=sistema_teletrabajo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=sistema_teletrabajo_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Solo indique IPs o rangos CIDR del proxy controlado, separados por coma. Nunca use *.
TRUSTED_PROXIES=
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_CONTENT_SECURITY_POLICY="frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
SECURITY_PERMISSIONS_POLICY="camera=(), geolocation=(), microphone=()"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

DOCUMENT_MAX_FILE_SIZE_KB=20480
DOCUMENT_MAX_FILES_PER_REQUEST=10
DOCUMENT_DUE_SOON_DAYS=3
DOCUMENT_DEADLINE_REMINDER_HOUR=8
DOCUMENT_DECISION_REASON_MAX_LENGTH=2000
DOCUMENT_ANNULMENT_REASON_MAX_LENGTH=2000
DOCUMENT_CODE_DIGITS=6
DOCUMENT_HISTORY_PER_PAGE=15
DOCUMENT_SEARCH_PER_PAGE=15
DOCUMENT_NOTIFICATIONS_PER_PAGE=15
REPORTS_PER_PAGE=25
REPORT_EXPORT_MAX_ROWS=5000
AUDIT_LOGS_PER_PAGE=25

VITE_APP_NAME="${APP_NAME}"
