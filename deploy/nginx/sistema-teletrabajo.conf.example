server {
    listen 80;
    listen [::]:80;
    server_name documentos.example.edu.bo;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name documentos.example.edu.bo;
    server_tokens off;

    root /var/www/sistema-teletrabajo/public;
    index index.php;
    autoindex off;
    client_max_body_size 220m;

    ssl_certificate /etc/letsencrypt/live/documentos.example.edu.bo/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/documentos.example.edu.bo/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    # Habilitar HSTS solo después de validar HTTPS, renovación y subdominios.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /storage/ {
        deny all;
        return 404;
    }

    location ^~ /build/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.5-fpm-sistema-teletrabajo.sock;
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* \.(?:env|ini|log|sql|sqlite|bak|backup|toml|ya?ml)$ {
        deny all;
    }

    access_log /var/log/nginx/sistema-teletrabajo.access.log;
    error_log /var/log/nginx/sistema-teletrabajo.error.log warn;
}
